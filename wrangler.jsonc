// Cloudflare (Workers static assets). Cloudflare runs the build command `sh build.sh`, which writes public/,
// then `npx wrangler deploy` uploads public/. Security headers come from public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitwise",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  }
}
